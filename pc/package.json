{
  "name": "litlejacob-cloud",
  "productName": "LitleJacob Cloud",
  "version": "1.0.1",
  "description": "Panel de tu Chrome en la nube",
  "author": "Bryan Tirapo Bustillos",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "trade.litlejacob.cloud",
    "productName": "LitleJacob Cloud",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "ui/**/*", "package.json"],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "LitleJacobCloud-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LitleJacob Cloud",
      "runAfterFinish": true
    },
    "publish": [
      { "provider": "generic", "url": "https://github.com/BryanTb22/pantalla-app/releases/download/pc" }
    ]
  }
}
